# 必填
BASE_URL = ""                              # API 基础地址
AUTHORIZATION = ""                         # Authorization 令牌（可从抓包获得）
CLINIC_ID = ""                             # 诊所ID
USER_ID = ""                               # 用户ID（锁定和下单时使用）
MEMBER_ID = ""                             # 就诊人ID（下单时需要）
PAT_NAME = ""                              # 患者姓名
PAT_SEX = ""                               # 性别（如"男"）
PAT_BIRTHDAY = ""                          # 生日（格式"2006-12-01"）
# 可选
PAT_ID_NUMBER = ""                         # 身份证号（可选）
PAT_ADDRESS = ""                           # 地址（可选）
ALLERGIES = "暂无过敏史"                    # 过敏史